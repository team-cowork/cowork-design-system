{
  "name": "@team-cowork/design-system",
  "version": "0.1.0",
  "description": "Cowork 웹 디자인 시스템: 디자인 토큰, 아이콘, React 컴포넌트",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/team-cowork/cowork-design-system.git",
    "directory": "packages/web"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./theme.css": "./dist/styles/theme.css",
    "./tokens.css": "./dist/styles/tokens.css"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node ../../scripts/build-tokens.mjs && rm -rf dist && tsc -p tsconfig.build.json && cp -R src/styles dist/styles",
    "typecheck": "tsc --noEmit",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19",
    "tailwindcss": ">=4"
  },
  "dependencies": {
    "tailwind-variants": "4.0.2"
  },
  "devDependencies": {
    "@storybook/react-vite": "^10.6.8",
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "storybook": "^10.6.8",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vite": "^8.3.8"
  }
}
