{
  "name": "cowork-design-system",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.6.0",
  "scripts": {
    "tokens": "node scripts/build-tokens.mjs",
    "test": "node --test 'scripts/*.test.mjs'",
    "build": "pnpm --filter @team-cowork/design-system build",
    "storybook": "pnpm --filter @team-cowork/design-system storybook",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1"
  }
}
